# Servora Auth — environment configuration
# Copy to .env for local development. Never commit a real .env file.

# --- Runtime ---
NODE_ENV=development
PORT=4001
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (PostgreSQL is authoritative — see servora-docs/02-architecture/database-architecture.md) ---
DATABASE_URL=postgresql://auth:auth@localhost:5432/servora_auth

# --- Redis (non-authoritative: rate limits, cooldowns, OAuth state — never the source of truth) ---
REDIS_URL=redis://localhost:6379

# --- Session cookie ---
# Name of the HttpOnly session cookie. Must match SESSION_COOKIE_NAME on the
# API Gateway (servora-api-gateway/.env.example) so it forwards the same cookie.
SESSION_COOKIE_NAME=servora_session
# Leave unset for host-only cookies in local development. In production set
# to the shared parent domain, e.g. ".servora.hemandu.com".
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
# Defaults to true in production, false otherwise. Refuses to boot as false
# in production (see src/config/env.ts).
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=604800

# --- Internal service authentication ---
# Shared secret the API Gateway must send as `x-servora-internal-key` when
# calling POST /internal/v1/sessions/verify. Never expose to a browser or
# frontend build. Required to be >= 32 chars in production.
INTERNAL_SERVICE_KEY=change-me-to-a-long-random-value-in-every-environment

# --- Google OAuth / OpenID Connect ---
# Leave unset to run without Google sign-in enabled; the google/* routes
# then return 503 GOOGLE_OAUTH_NOT_CONFIGURED instead of failing unsafely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the public URL that reaches this service's
# /api/v1/auth/google/callback (typically via the API Gateway), and must be
# registered as an authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=
# Frontend URL to redirect the browser to after a successful Google login.
OAUTH_POST_LOGIN_REDIRECT_URL=

# --- Notification integration (PROPOSED contract — see README.md) ---
# Base URL of servora-notification. Leave unset to run without delivery —
# verification/reset challenges are still created and persisted, just not
# sent anywhere (a clear warning is logged, nothing is silently dropped).
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_TIMEOUT_MS=5000

# --- Email verification ---
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=3600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# --- Password reset ---
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
PASSWORD_RESET_COOLDOWN_SECONDS=60

# --- Phone OTP ---
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# --- Request handling ---
REQUEST_ID_HEADER=x-request-id
BODY_LIMIT_BYTES=1048576
